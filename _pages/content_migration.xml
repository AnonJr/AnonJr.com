---
layout: compress
permalink: /content_migration.xml
published: false
sitemap: false
---
<?xml version="1.0" encoding="UTF-8" ?>

{% capture relative_href %}href="{{ site.url }}/{% endcapture %}
{% capture relative_src %}src="{{ site.url }}/{% endcapture %}

<rss version="2.0"
     xmlns:content="http://purl.org/rss/1.0/modules/content/"
     xmlns:dc="http://purl.org/dc/elements/1.1/">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <link>{{ site.url }}</link>
    <description>{{ site.description | xml_escape }}</description>

    {% for post in site.posts %}
    <item>
      <title>{{ post.title | replace: '&hellip;', '…' | xml_escape }}</title>
      <link>{{ post.url | absolute_url }}</link>
      <guid isPermaLink="true">{{ post.url | absolute_url }}</guid>
      <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>

      <dc:creator>{% if post.author %}{{ post.author | xml_escape }}{% else %}{{ site.author.name | default: site.author | xml_escape }}{% endif %}</dc:creator>

      {% for category in post.categories %}
      <category><![CDATA[{{ category }}]]></category>
      {% endfor %}

      {% for tag in post.tags %}
      <category><![CDATA[{{ tag }}]]></category>
      {% endfor %}

      {% assign absolute_excerpt = post.excerpt
        | replace: 'href="/', relative_href
        | replace: 'src="/', relative_src
      %}

      <description><![CDATA[
        {{ absolute_excerpt }}
      ]]></description>

      {% assign absolute_content = post.content
        | replace: 'href="/', relative_href
        | replace: 'src="/', relative_src
      %}

      <content:encoded><![CDATA[
        {{ absolute_content }}
        <hr>
        <p><em>Originally published at <a href="{{ post.url | absolute_url }}">AnonJr.com</a>, the canonical home of my writing.</em></p>
      ]]></content:encoded>
    </item>
    {% endfor %}

  </channel>
</rss>
