---
layout: null
permalink: /content_migration.xml
published: false
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>

<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.locale }}">
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <id>{{ site.url }}/</id>
  <updated>{{ site.time | date_to_xmlschema }}</updated>

  {% for post in site.posts %}
  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}" rel="alternate"/>
    <id>{{ post.url | absolute_url }}</id>
    <updated>{{ post.date | date_to_xmlschema }}</updated>

    <content type="html">
      <![CDATA[
        {{ post.content | absolute_urls }}
        <hr>
        <p><em>Originally published at <a href="{{ post.url | absolute_url }}">AnonJr.com</a>, the canonical home of my writing.</em></p>
      ]]>
    </content>

    <author>
      <name>{% if post.author %}{{ post.author | xml_escape }}{% else %}{{ site.author.name | xml_escape }}{% endif %}</name>
    </author>

  </entry>
  {% endfor %}

</feed>
