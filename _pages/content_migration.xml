---
layout: null
permalink: /content_migration.xml
published: false
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>

<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.locale }}">
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle> <!-- Site description -->
  <id>{{ site.url }}/</id>
  <updated>{{ site.time | date_to_xmlschema }}</updated>

  {% for post in site.posts %}
  <entry>
    <title>{{ post.title | xml_escape | replace: '&mdash;', '&#8212;' | replace: '&hellip;', '&#8230;' }}</title>
    <link href="{{ post.url | absolute_url }}"/>
    <id>{{ post.url | absolute_url }}</id>
    <updated>{{ post.date | date_to_xmlschema }}</updated>
    <summary>{{ post.excerpt | strip_html | replace: '&mdash;', '&#8212;' | replace: '&hellip;', '&#8230;' }}</summary>
    <content type="html">
      {{ post.content | xml_escape | absolute_urls | replace: '&mdash;', '&#8212;' | replace: '&hellip;', '&#8230;' }}
      <hr>
      <p><em>Originally published at <a href="{{ post.url | absolute_url }}">AnonJr.com</a>.</em></p>
    </content>

    {% if post.author %}
      <author>
        <name>{{ post.author | xml_escape }}</name>
      </author>
    {% else %}
      <author>
        <name>{{ site.author | xml_escape }}</name>
      </author>
    {% endif %}

  </entry>
  {% endfor %}

</feed>
